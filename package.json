{
  "name": "@cocreate/ast",
  "version": "1.0.0",
  "description": "CoCreate's declarative abstract syntax tree evaluator for client and server applications.",
  "keywords": [
    "cocreate",
    "ast",
    "abstract-syntax-tree",
    "evaluator",
    "declarative",
    "workflow",
    "client",
    "server"
  ],
  "publishConfig": { "access": "public" },
  "type": "module",
  "main": "./src/server.js",
  "browser": "./src/client.js",
  "exports": {
    ".": {
      "node": "./src/server.js",
      "deno": "./src/server.js",
      "browser": "./src/client.js",
      "default": "./src/server.js"
    },
    "./server": "./src/server.js",
    "./client": "./src/client.js"
  },
  "files": [
    "src/",
    "specifications/",
    "docs/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CoCreateJS/ast.git"
  },
  "author": "CoCreate LLC",
  "bugs": { "url": "https://github.com/CoCreateJS/ast/issues" },
  "homepage": "https://CoCreateJS.com/docs/ast",
  "scripts": {
    "test": "node --test"
  },
  "dependencies": { "@cocreate/utils": "^2.0.3" }
}
